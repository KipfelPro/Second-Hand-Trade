.pet-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 34; background: rgba(49,24,42,.14); animation: pet-mask-in 150ms ease-out both; }
.pet-dock { position: fixed; z-index: 35; width: 80rpx; height: 80rpx; }
.pet-dock.pet-inline { position: relative; z-index: auto; width: 76rpx; height: 76rpx; }
.pet-inline .pet-trigger { width: 76rpx; height: 76rpx; }
.pet-trigger { position: relative; width: 80rpx; height: 80rpx; padding: 7rpx; box-sizing: border-box; border-radius: 50%; border: 1rpx solid rgba(31,22,26,.06); background: #fff; box-shadow: 0 2rpx 6rpx rgba(31,22,26,.05), 0 10rpx 24rpx rgba(31,22,26,.10); transition: transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease; }
.pet-body { position: relative; width: 100%; height: 100%; pointer-events: none; }
.pet-face, .pet-side { position: absolute; inset: 0; }
.pet-side { opacity: 0; }
.pet-side-left { transform: scaleX(-1); }
.pet-shadow { position: absolute; left: 21%; bottom: 8%; width: 58%; height: 15%; border-radius: 50%; background: radial-gradient(ellipse, rgba(98,40,66,.32), rgba(98,40,66,0) 72%); pointer-events: none; }
.pet-inline .pet-body { animation: pet-bob 2.2s ease-in-out infinite; }
.pet-stunts .pet-body { animation: pet-stunt 8.4s linear infinite; }
.pet-stunts .pet-face { animation: pet-front 8.4s linear infinite; }
.pet-stunts .pet-side-right { animation: pet-right-profile 8.4s linear infinite; }
.pet-stunts .pet-side-left { animation: pet-left-profile 8.4s linear infinite; }
.pet-stunts .pet-shadow { animation: pet-depth-shadow 8.4s ease-in-out infinite; }
.pet-dragging .pet-trigger { transform: scale(1.08); opacity: 1; box-shadow: 0 12rpx 34rpx rgba(114,44,72,.27); }
.pet-dragging .pet-body, .pet-dragging .pet-blink { animation-play-state: paused; }
.pet-body image, .pet-portrait image { display: block; width: 100%; height: 100%; }
.pet-blink { position: absolute; inset: 0; opacity: 0; pointer-events: none; animation: pet-blink 5.4s step-end .7s infinite; }
.pet-blink view { position: absolute; top: 50.4%; width: 8%; height: 7.6%; border-radius: 50%; background: #eed0a9; }
.pet-blink view::after { position: absolute; top: 37%; left: 10%; right: 10%; height: 2rpx; background: #674637; border-radius: 50%; content: ''; }
.pet-blink view:first-child { left: 36.1%; }
.pet-blink view:last-child { left: 59.7%; }
.pet-body.mood-perk, .pet-portrait.mood-perk { animation: pet-perk 480ms ease-out both; }
.pet-body.mood-feed, .pet-portrait.mood-feed { animation: pet-feed 570ms ease-in-out both; }
.pet-body.mood-pat, .pet-portrait.mood-pat { animation: pet-pat 620ms ease-in-out both; }
.pet-reaction { position: absolute; top: -7rpx; right: -2rpx; width: 30rpx; height: 30rpx; pointer-events: none; color: #a62f63; font-weight: 750; line-height: 1; text-shadow: 0 1rpx 5rpx #fff; }
.pet-reaction text { position: absolute; top: 0; left: 0; font-size: 32rpx; animation: pet-reaction 800ms cubic-bezier(.2,.62,.38,1) both; }
.pet-reaction text:nth-child(2) { top: 9rpx; left: -31rpx; color: #a63c6c; font-size: 23rpx; animation-delay: 75ms; }
.pet-reaction text:nth-child(3) { top: 13rpx; left: 24rpx; color: #bc587b; font-size: 18rpx; animation-delay: 140ms; }
.reaction-feed text { color: #a9582e; }
.pet-active { opacity: 1; background: #fff; }
.pet-press { opacity: .72; }
.pet-panel, .pet-hint { position: fixed; box-sizing: border-box; border: 0; box-shadow: 0 4px 10px rgba(31,22,26,.06), 0 18px 44px rgba(31,22,26,.16); animation: panel-rise 150ms ease-out both; }
.pet-panel { z-index: 36; display: flex; flex-direction: column; gap: 8px; padding: 14px; border-radius: 22px; background: #fff; overflow: hidden; }
.pet-panel.pet-closing { pointer-events: none; animation: panel-leave var(--pet-leave-ms) ease-in both; }
.pet-backdrop.pet-closing { pointer-events: none; animation: pet-mask-out var(--pet-leave-ms) ease-in both; }
.pet-hint { z-index: 35; padding: 9px 13px; border-radius: 14px; background: rgba(31, 26, 28, .92); color: #fff; font-size: 13px; line-height: 1.45; letter-spacing: .3px; }
.pet-panel-head { display: flex; flex: none; gap: 9px; align-items: center; min-height: 44px; padding-right: 46px; }
.pet-portrait { display: block; width: 42px; height: 42px; flex: none; border-radius: 14px; background: #f6ebee; }
.pet-identity { flex: 1; min-width: 0; }
.pet-name { overflow: hidden; color: #1f1a1c; font-size: 18px; font-weight: 650; line-height: 1.2; letter-spacing: 1px; white-space: nowrap; text-overflow: ellipsis; }
.pet-caption { display: block; overflow: hidden; margin-top: 3px; color: #7a6f73; font-size: 14px; line-height: 1.28; white-space: nowrap; text-overflow: ellipsis; }
.pet-close { position: absolute; top: 11px; right: 11px; z-index: 1; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 44px; height: 44px; border-radius: 22px; background: #f4f0ed; }
.pet-panel-body { flex: 0 1 auto; min-height: 0; overflow-y: auto; }
.pet-care, .pet-shortcuts { display: flex; align-items: stretch; gap: 7px; }
.pet-shortcuts { margin-top: 8px; }
.pet-action, .pet-open, .pet-care button { display: flex; align-items: center; justify-content: center; gap: 4px; min-width: 0; min-height: 42px; margin: 0; padding: 0 2px; border-radius: 12px; color: #3d3538; background: #f6f3f0; font-size: 14px; line-height: 1.2; font-weight: 600; white-space: nowrap; }
.pet-action, .pet-care button { flex: 1 1 0; width: 0; }
.pet-care button { min-height: 44px; color: #8c2346; background: #f6ebee; }
.pet-action::after, .pet-open::after, .pet-care button::after { border: 0; }
.pet-open { justify-content: space-between; width: 100%; min-height: 46px; padding: 0 16px; margin-top: 8px; border-radius: 23px; background: #1f1a1c; color: #fff; font-size: 15px; letter-spacing: 1px; }
.pet-open t-icon { flex: none; }
@keyframes pet-bob { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-5rpx) rotate(3deg); } }
/* 两次动作之间保持静稳，固定的外层继续承接点击和拖拽。 */
@keyframes pet-stunt {
  0%   { transform: perspective(210rpx) translateY(0) rotateZ(0deg) rotateY(0deg) scale(1,1); }
  9%   { transform: perspective(210rpx) translateY(-5rpx) rotateZ(5deg) rotateY(8deg) scale(1.02,1.04); }
  18%  { transform: perspective(210rpx) translateY(2rpx) rotateZ(0deg) rotateY(0deg) scale(1.08,.91); }
  20%  { transform: perspective(210rpx) translateY(-5rpx) rotateZ(-34deg) rotateY(0deg) scale(1,1.02); }
  23%  { transform: perspective(210rpx) translateY(-14rpx) rotateZ(-135deg) rotateY(0deg) scale(1.01,1.02); }
  27%  { transform: perspective(210rpx) translateY(-16rpx) rotateZ(-263deg) rotateY(0deg) scale(.99,.99); }
  30%  { transform: perspective(210rpx) translateY(-7rpx) rotateZ(-337deg) rotateY(0deg) scale(1,1.03); }
  32%  { transform: perspective(210rpx) translateY(2rpx) rotateZ(-360deg) rotateY(0deg) scale(1.10,.90); }
  37%  { transform: perspective(210rpx) translateY(-4rpx) rotateZ(-360deg) rotateY(0deg) scale(.97,1.04); }
  43%  { transform: perspective(210rpx) translateY(0) rotateZ(-360deg) rotateY(0deg) scale(1,1); }
  53%  { transform: perspective(210rpx) translateY(-4rpx) rotateZ(-356deg) rotateY(5deg) scale(1,1.02); }
  56%  { transform: perspective(210rpx) translateY(1rpx) rotateZ(-364deg) rotateY(-16deg) scale(1.04,.93); }
  60%  { transform: perspective(210rpx) translateY(-9rpx) rotateZ(-353deg) rotateY(26deg) scale(.90,1.04); }
  63%  { transform: perspective(210rpx) translateY(-13rpx) rotateZ(-360deg) rotateY(4deg) scale(.78,1.05); }
  67%  { transform: perspective(210rpx) translateY(-8rpx) rotateZ(-367deg) rotateY(-26deg) scale(.90,1.04); }
  72%  { transform: perspective(210rpx) translateY(2rpx) rotateZ(-360deg) rotateY(0deg) scale(1.07,.94); }
  78%  { transform: perspective(210rpx) translateY(-3rpx) rotateZ(-357deg) rotateY(5deg) scale(.99,1.03); }
  88%  { transform: perspective(210rpx) translateY(0) rotateZ(-363deg) rotateY(-5deg) scale(1,1); }
  100% { transform: perspective(210rpx) translateY(0) rotateZ(-360deg) rotateY(0deg) scale(1,1); }
}
@keyframes pet-front { 0%, 56%, 72%, 100% { opacity: 1; } 60%, 67% { opacity: .15; } 63.5% { opacity: .54; } }
@keyframes pet-right-profile { 0%, 56%, 65%, 100% { opacity: 0; } 60% { opacity: .94; } }
@keyframes pet-left-profile { 0%, 62%, 72%, 100% { opacity: 0; } 67% { opacity: .94; } }
@keyframes pet-depth-shadow {
  0%, 18%, 32%, 43%, 56%, 71%, 100% { transform: scaleX(1); opacity: .9; }
  24%, 27%, 61%, 66% { transform: scaleX(.60); opacity: .38; }
}
@keyframes pet-blink { 0%,91%,96%,100% { opacity: 0; } 92% { opacity: 1; } }
@keyframes pet-perk { 0%,100% { transform: none; } 40% { transform: translateY(-7rpx) scale(1.13) rotate(-8deg); } 70% { transform: rotate(5deg); } }
@keyframes pet-feed { 0%,100% { transform: none; } 25%,65% { transform: scale(1.10,.90); } 45%,82% { transform: translateY(-4rpx) scale(.95,1.06); } }
@keyframes pet-pat { 0%,100% { transform: none; } 30% { transform: rotate(-12deg) translateY(-3rpx); } 70% { transform: rotate(12deg) translateY(-4rpx); } }
@keyframes pet-reaction { 0% { opacity: 0; transform: translateY(4rpx) scale(.55) rotate(-12deg); } 27% { opacity: 1; } 64% { opacity: .82; } 100% { opacity: 0; transform: translateY(-36rpx) scale(1.2) rotate(12deg); } }
@keyframes panel-rise { from { opacity: 0; transform: translateY(11rpx) scale(.97); } to { opacity: 1; transform: none; } }
@keyframes panel-leave { to { opacity: 0; transform: translateY(8rpx) scale(.98); } }
@keyframes pet-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes pet-mask-out { to { opacity: 0; } }
.pet-motion-off.pet-panel, .pet-motion-off.pet-hint, .pet-motion-off.pet-backdrop, .pet-motion-off .pet-body, .pet-motion-off .pet-portrait, .pet-motion-off .pet-blink, .pet-motion-off .pet-reaction text, .pet-inactive .pet-body, .pet-inactive .pet-blink { animation: none; }
.pet-motion-off .pet-trigger { transition: none; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .pet-panel, .pet-hint, .pet-backdrop, .pet-body, .pet-portrait, .pet-face, .pet-side, .pet-shadow, .pet-blink, .pet-reaction text { animation: none !important; }
  .pet-trigger, .pet-dragging .pet-trigger { transition: none; transform: none; }
}

