:host { display: block; width: 100%; min-width: 0; }
.tile { overflow: hidden; background: #fff; border-radius: 20rpx; box-shadow: 0 1rpx 2rpx rgba(31, 22, 26, .03), 0 10rpx 26rpx rgba(31, 22, 26, .06); }
.tile-pressed { opacity: .86; transform: scale(.995); }
.visual { position: relative; height: 252rpx; background: #f1ecea; overflow: hidden; }
.tall .visual { height: 320rpx; }
.photo { display: block; width: 100%; height: 100%; }
.tags { display: flex; flex-wrap: wrap; column-gap: 6rpx; row-gap: 6rpx; position: absolute; left: 14rpx; top: 14rpx; }
.tags text { background: rgba(255, 255, 255, .92); color: #3c5546; padding: 3rpx 11rpx; border-radius: 6rpx; font-size: 20rpx; font-weight: 600; letter-spacing: 1rpx; backdrop-filter: blur(4rpx); }
.tags .sale { color: #8c2346; background: rgba(252, 239, 243, .96); }
.inactive { position: absolute; left: 14rpx; top: 14rpx; padding: 4rpx 12rpx; border-radius: 6rpx; background: rgba(255, 255, 255, .94); color: #6f6469; font-size: 20rpx; letter-spacing: 1rpx; }
.body { padding: 16rpx 18rpx 18rpx; min-width: 0; }
.title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: #1f1a1c; font-size: 30rpx; font-weight: 600; line-height: 1.38; letter-spacing: .4rpx; overflow: hidden; }
.foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 10rpx; margin-top: 10rpx; }
.price { color: #1f1a1c; font-size: 36rpx; font-weight: 700; line-height: 1.1; letter-spacing: -.5rpx; font-variant-numeric: tabular-nums; }
.currency { font-size: 21rpx; font-weight: 600; margin-right: 2rpx; }
.meta { display: flex; align-items: center; gap: 6rpx; padding-bottom: 3rpx; font-size: 21rpx; color: #9a9095; letter-spacing: .5rpx; min-width: 0; }
.college { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.level { white-space: nowrap; color: #7d9187; }
.campus-mark { display: flex; gap: 6rpx; align-items: center; margin-bottom: 6rpx; color: #7b8d83; font-size: 21rpx; font-weight: 600; letter-spacing: 1rpx; }
.campus-mark.weijin { color: #9c7c85; }
.campus-point { width: 7rpx; height: 7rpx; border-radius: 50%; background: currentColor; }
.list { display: flex; align-items: stretch; min-height: 188rpx; }
.list .visual { width: 188rpx; height: auto; flex: 0 0 188rpx; }
.list .photo { position: absolute; inset: 0; }
.list .body { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 18rpx 20rpx; }
.list .title { font-size: 31rpx; -webkit-line-clamp: 2; }
.list .foot { margin-top: 12rpx; }
.list .tags { left: 10rpx; top: 10rpx; gap: 4rpx; }
.list .tags text { font-size: 17rpx; padding: 2rpx 7rpx; }
