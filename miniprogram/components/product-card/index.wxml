<view wx:if="{{product.id}}" class="tile {{layout}}" hover-class="tile-pressed" bindtap="open" aria-role="button" aria-label="{{product.title}}">
  <view class="visual">
    <image class="photo" src="{{cover}}" mode="aspectFill" lazy-load="{{true}}"/>
    <view wx:if="{{tags.length && product.status === 'active'}}" class="tags">
      <text wx:for="{{tags}}" wx:key="*this" class="{{item === '毕业清仓' ? 'sale' : ''}}">{{item}}</text>
    </view>
    <text wx:elif="{{product.status !== 'active'}}" class="inactive">{{product.status === 'sold' ? '已售出' : '已下架'}}</text>
  </view>
  <view class="body">
    <view wx:if="{{product.campus && !hideCampus}}" class="campus-mark {{product.campusId}}"><text class="campus-point"/>{{product.campus}}</view>
    <view class="title">{{product.title}}</view>
    <view class="foot">
      <view class="price"><text class="currency">¥</text>{{product.price}}</view>
      <view wx:if="{{seller}}" class="meta">
        <text wx:if="{{!hideCollege}}" class="college">{{seller.college}}</text>
        <text class="level">{{level}}</text>
      </view>
    </view>
  </view>
</view>
