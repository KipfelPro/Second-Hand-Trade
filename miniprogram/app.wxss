page {
  --pink: #a3264f;
  --accent: #a3264f;
  --accent-deep: #7d1a3b;
  --accent-soft: #f6ebee;
  --ink: #1f1a1c;
  --ink-2: #3d3538;
  --muted: #7a6f73;
  --faint: #a69ca0;
  --line: #ece6e3;
  --line-strong: #ded5d1;
  --paper: #f7f4f0;
  --surface: #ffffff;
  --rose: #f6ebee;
  --sage: #47705c;
  --sage-soft: #ecf2ee;
  --gold: #a07a3c;
  --shadow-sm: 0 2rpx 6rpx rgba(31, 22, 26, .04), 0 8rpx 24rpx rgba(31, 22, 26, .05);
  --shadow-md: 0 4rpx 12rpx rgba(31, 22, 26, .05), 0 18rpx 48rpx rgba(31, 22, 26, .08);
  --serif: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif SC', serif;
  background: #f7f4f0;
  color: #1f1a1c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
view, button, input, textarea, image, scroll-view { box-sizing: border-box; }
button { padding: 0; margin: 0; font-size: inherit; line-height: inherit; color: inherit; background: transparent; }
button::after { border: 0; }
button[disabled] { opacity: .45; }
image { display: block; }
.page { padding: 28rpx 32rpx 56rpx; }
.card { background: #fff; border: 0; border-radius: 24rpx; box-shadow: var(--shadow-sm); }
.primary, .secondary {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  min-height: 92rpx; padding: 0 32rpx; border-radius: 999rpx; font-size: 32rpx; font-weight: 600; letter-spacing: 2rpx;
}
.primary { background: #1f1a1c; color: #fff; box-shadow: 0 10rpx 28rpx rgba(31, 22, 26, .16); }
.primary[disabled] { background: #1f1a1c; color: #fff; box-shadow: none; }
.secondary { color: #1f1a1c; background: #fff; box-shadow: inset 0 0 0 1.5rpx #ded5d1; }
.pressed, .tap, .button-hover { opacity: .78; transform: scale(.985); }
.tag { display: inline-flex; align-items: center; padding: 4rpx 14rpx; border-radius: 8rpx; background: #f6ebee; color: #8c2346; font-size: 22rpx; line-height: 1.5; letter-spacing: 1rpx; }
.muted { color: var(--muted); }
.empty { text-align: center; padding: 96rpx 24rpx; color: #7a6f73; }
.section-title { font-size: 34rpx; line-height: 1.3; font-weight: 650; letter-spacing: 1rpx; color: #1f1a1c; }
.eyebrow { font-size: 20rpx; letter-spacing: 6rpx; text-transform: uppercase; color: #a69ca0; font-weight: 600; }
.serif { font-family: var(--serif); }
.footer-safe { padding-bottom: calc(26rpx + env(safe-area-inset-bottom)); }
