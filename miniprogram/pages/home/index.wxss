page { background: #f7f4f0; }

.landing {
  padding: 16rpx 32rpx 64rpx;
  background:
    radial-gradient(120% 60% at 100% 0%, rgba(163, 38, 79, .07) 0%, rgba(163, 38, 79, 0) 60%),
    #f7f4f0;
}

.stream-heading,
.search-box,
.feed-header,
.feed-all,
.feed-tools,
.filter-row,
.hero-label,
.hero-button,
.campus { display: flex; align-items: center; }
.stream-heading, .feed-header, .feed-tools { justify-content: space-between; }

.stream-heading { padding: 14rpx 0 0; align-items: flex-start; }
.campus { gap: 10rpx; color: #7a6f73; font-size: 22rpx; font-weight: 500; letter-spacing: 4rpx; }
.campus-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #a3264f; }
.wordmark {
  margin-top: 8rpx;
  color: #1f1a1c;
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
  font-size: 62rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.16;
}
.icon-button {
  position: relative; display: flex; align-items: center; justify-content: center;
  width: 82rpx; height: 82rpx; margin-top: 6rpx;
  background: #fff; border-radius: 50%;
  box-shadow: 0 1rpx 2rpx rgba(31, 22, 26, .03), 0 8rpx 22rpx rgba(31, 22, 26, .06);
}
.message-dot { position: absolute; top: 19rpx; right: 19rpx; width: 12rpx; height: 12rpx; border: 4rpx solid #fff; border-radius: 50%; background: #a3264f; }

.find-panel { margin: 30rpx 0 30rpx; }
.campus-switch { display: flex; position: relative; padding: 6rpx; border-radius: 999rpx; background: #ece7e3; }
.campus-option {
  display: flex; flex: 1 1 0%; width: 0; position: relative;
  align-items: center; justify-content: center; min-width: 0; min-height: 62rpx;
  border-radius: 999rpx; color: #6f6469; padding: 0; margin: 0;
  font-size: 26rpx; font-weight: 500; letter-spacing: 1rpx; white-space: nowrap;
}
.campus-option text { max-width: 100%; }
.campus-option-active { color: #1f1a1c; font-weight: 650; }
.campus-track { position: absolute; inset: 6rpx; pointer-events: none; }
.campus-indicator { width: 33.333333%; height: 100%; border-radius: 999rpx; background: #fff; box-shadow: 0 2rpx 8rpx rgba(31, 22, 26, .09); transition: transform 200ms cubic-bezier(.2,.75,.35,1); }
.campus-indicator-1 { transform: translateX(100%); }
.campus-indicator-2 { transform: translateX(200%); }
.home-motion-off .campus-indicator { transition: none; }

.search-box {
  box-sizing: border-box; height: 84rpx; margin-top: 14rpx;
  padding: 0 10rpx 0 26rpx; gap: 14rpx;
  background: #fff; border-radius: 999rpx;
  box-shadow: 0 1rpx 2rpx rgba(31, 22, 26, .03), 0 8rpx 22rpx rgba(31, 22, 26, .05);
}
.search-input { flex: 1; min-width: 0; color: #1f1a1c; font-size: 28rpx; }
.search-placeholder { color: #a69ca0; }
.search-button {
  display: flex; align-items: center; justify-content: center; align-self: stretch;
  flex: 0 0 96rpx; width: 96rpx; min-width: 0; margin: 6rpx 0; padding: 0;
  border-radius: 999rpx; background: #1f1a1c; color: #fff; font-size: 26rpx; font-weight: 600; letter-spacing: 2rpx;
}

.hero { position: relative; margin-top: 8rpx; border-radius: 26rpx; overflow: hidden; box-shadow: 0 6rpx 16rpx rgba(31, 22, 26, .05), 0 22rpx 54rpx rgba(31, 22, 26, .10); }
.hero-swiper { height: 376rpx; }
.hero-slide { position: relative; width: 100%; height: 100%; overflow: hidden; background: #f3e9e4; }
.hero-slide::after { position: absolute; inset: 0; content: ''; background: linear-gradient(90deg, rgba(255, 247, 242, .97) 0%, rgba(255, 247, 242, .86) 38%, rgba(255, 247, 242, .10) 70%, rgba(255, 247, 242, 0) 100%); }
.slide-books::after { background: linear-gradient(90deg, rgba(250, 246, 238, .97) 0%, rgba(250, 246, 238, .85) 38%, rgba(250, 246, 238, .08) 72%, rgba(250, 246, 238, 0) 100%); }
.slide-publish::after { background: linear-gradient(90deg, rgba(243, 240, 238, .97) 0%, rgba(243, 240, 238, .87) 38%, rgba(243, 240, 238, .08) 72%, rgba(243, 240, 238, 0) 100%); }
.hero-pages {
  position: absolute; z-index: 2; bottom: 18rpx; left: 50%; transform: translateX(-50%);
  display: flex; align-items: center; border-radius: 999rpx; padding: 0 4rpx;
  background: rgba(255, 255, 255, .55);
}
.hero-page { flex: 0 0 46rpx; width: 46rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.hero-page view { width: 6rpx; height: 6rpx; border-radius: 6rpx; background: rgba(31, 22, 26, .30); transition: width 180ms ease, background 180ms ease; }
.hero-page-active view { width: 18rpx; background: #1f1a1c; }
.hero-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-content { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 0 30rpx; }
.hero-content-current { animation: hero-copy-in 240ms ease-out both; }
.home-motion-off .hero-content-current { animation: none; }
.home-motion-off .hero-page view { transition: none; }
@keyframes hero-copy-in {
  from { opacity: .5; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.hero-label {
  display: inline-flex; align-self: flex-start; padding: 6rpx 14rpx; gap: 6rpx;
  border-radius: 6rpx; background: rgba(255, 255, 255, .82);
  color: #8c2346; font-size: 21rpx; font-weight: 600; letter-spacing: 2rpx;
}
.hero-title {
  margin: 14rpx 0 22rpx; color: #1f1a1c;
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
  font-size: 54rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 1.22;
}
.hero-button {
  display: inline-flex; align-self: flex-start; width: auto;
  min-height: 64rpx; margin: 0; padding: 0 20rpx 0 24rpx; gap: 10rpx;
  border-radius: 999rpx; background: #1f1a1c; color: #fff;
  font-size: 25rpx; font-weight: 600; letter-spacing: 1rpx;
}

.shortcut-card {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 26rpx; padding: 26rpx 8rpx 10rpx;
  border-radius: 24rpx; background: #fff;
  box-shadow: 0 1rpx 2rpx rgba(31, 22, 26, .03), 0 10rpx 26rpx rgba(31, 22, 26, .05);
}
.shortcut { min-width: 0; padding: 0 4rpx 16rpx; }
.shortcut-inner {
  display: flex; align-items: center; flex-direction: column; justify-content: flex-start;
  gap: 12rpx; min-height: 124rpx; color: #3d3538;
  font-size: 24rpx; font-weight: 500; letter-spacing: 1rpx; white-space: nowrap;
  border-radius: 16rpx;
}
.shortcut-icon {
  display: flex; justify-content: center; align-items: center;
  width: 76rpx; height: 76rpx; flex-shrink: 0;
  border-radius: 24rpx; background: #f4eeea;
}
.shortcut-graduation { background: #f5eee2; }
.shortcut-digital { background: #eeebf2; }
.shortcut-life { background: #e9f0eb; }
.shortcut-style { background: #f5ece5; }
.shortcut-other { background: #f1eeef; }
.shortcut-entry-wants .shortcut-inner { color: #8c2346; }
.shortcut-entry-wants { grid-column: span 2; }
.shortcut-entry-wants .shortcut-inner { flex-direction: row; justify-content: center; gap: 12rpx; margin-top: 4rpx; min-height: 96rpx; border-radius: 20rpx; background: #f8edf0; }
.shortcut-entry-wants .shortcut-wants { width: 52rpx; height: 52rpx; border-radius: 16rpx; }
.shortcut-wants { background: #a3264f; box-shadow: 0 8rpx 18rpx rgba(163, 38, 79, .24); }
.shortcut-entry-wants text { font-weight: 600; }

.feed-header { margin: 52rpx 0 20rpx; align-items: flex-end; }
.feed-eyebrow { margin-bottom: 6rpx; color: #a69ca0; font-size: 19rpx; font-weight: 600; letter-spacing: 6rpx; }
.feed-title { color: #1f1a1c; font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif; font-size: 48rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 1.18; }
.feed-all { min-height: 48rpx; color: #7a6f73; font-size: 24rpx; letter-spacing: 1rpx; padding-bottom: 6rpx; }

.feed-tools { gap: 12rpx; margin-bottom: 22rpx; align-items: center; }
.filter-row { gap: 8rpx; flex: 1; min-width: 0; overflow: hidden; }
.filter-chip {
  padding: 11rpx 18rpx; border-radius: 999rpx; color: #6f6469;
  background: transparent; box-shadow: inset 0 0 0 1rpx #e3dbd6;
  font-size: 24rpx; white-space: nowrap; letter-spacing: .5rpx;
}
.filter-chip-active { color: #fff; background: #1f1a1c; box-shadow: none; font-weight: 600; }
.feed-publish {
  display: flex; align-items: center; gap: 4rpx; min-height: 54rpx;
  padding: 0 20rpx; border-radius: 999rpx;
  color: #fff; background: #a3264f;
  font-size: 24rpx; font-weight: 600; letter-spacing: 1rpx; white-space: nowrap;
}
.feed-publish text { font-size: 28rpx; line-height: 1; font-weight: 400; }

.market-section { margin-top: 30rpx; padding: 0; border-radius: 0; background: transparent; }
.market-heading { display: flex; align-items: center; justify-content: space-between; min-height: 52rpx; gap: 8rpx; margin-bottom: 16rpx; padding: 0; }
.market-name { display: flex; align-items: center; gap: 10rpx; color: #3d3538; font-size: 26rpx; font-weight: 600; white-space: nowrap; letter-spacing: 2rpx; }
.market-name view { width: 7rpx; height: 7rpx; border-radius: 50%; background: #b08b78; }
.market-beiyang .market-name view { background: #7b9183; }
.market-name text { color: #a69ca0; font-size: 21rpx; font-weight: 400; letter-spacing: .5rpx; }
.market-browse { display: flex; align-items: center; min-height: 48rpx; gap: 4rpx; color: #8c8286; font-size: 22rpx; white-space: nowrap; }
.stream { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; align-items: start; }
.stream-column { display: flex; flex-direction: column; gap: 18rpx; min-width: 0; }
.stream-empty { padding: 54rpx 22rpx; text-align: center; font-size: 26rpx; color: #8c8286; }
.home-pressed { opacity: .72; }

@media (prefers-reduced-motion: reduce) {
  .campus-indicator, .hero-page view { transition: none; }
  .hero-content-current { animation: none; }
}
