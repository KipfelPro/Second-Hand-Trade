page { background: #f7f4f0; }
.messages-page { padding: 20rpx 28rpx 80rpx; }
.message-tabs { display: flex; gap: 6rpx; margin-bottom: 16rpx; padding: 6rpx; border-radius: 999rpx; background: #ece7e3; }
.message-tab {
  flex: 1 1 0; display: flex; justify-content: center; align-items: center; gap: 6rpx;
  min-width: 0; min-height: 68rpx; border-radius: 999rpx;
  color: #6f6469; font-size: 25rpx; font-weight: 500; letter-spacing: .5rpx; white-space: nowrap;
}
.message-tab.active { background: #fff; color: #1f1a1c; font-weight: 650; box-shadow: 0 2rpx 8rpx rgba(31, 22, 26, .09); }
.tab-count { box-sizing: border-box; min-width: 26rpx; padding: 2rpx 6rpx; border-radius: 999rpx; background: #a3264f; color: #fff; font-size: 18rpx; text-align: center; line-height: 1.4; }
.conversation-roles { display: flex; gap: 10rpx; margin: 0 0 22rpx; }
.conversation-role {
  display: flex; flex: 1; align-items: center; justify-content: center; gap: 8rpx;
  min-height: 68rpx; padding: 0 10rpx;
  border-radius: 999rpx; background: transparent; box-shadow: inset 0 0 0 1.5rpx #e3dbd6;
  color: #6f6469; font-size: 24rpx; font-weight: 500; letter-spacing: 1rpx;
}
.conversation-role.role-active { background: #1f1a1c; color: #fff; box-shadow: none; font-weight: 600; }
.conversation-role .tab-count { background: rgba(255, 255, 255, .2); }
.conversation-list { display: flex; flex-direction: column; gap: 14rpx; }
.conversation { padding: 26rpx 26rpx 22rpx; border-radius: 22rpx; }
.conversation-header { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.conversation-name { color: #1f1a1c; font-size: 28rpx; font-weight: 650; letter-spacing: 1rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conversation-header .message-date { margin-left: auto; }
.peer-avatar { width: 52rpx; height: 52rpx; flex: none; border-radius: 50%; background: #f1ebe8; }
.peer-label { flex: none; padding: 1rpx 9rpx; border-radius: 999rpx; background: #f4f0ed; color: #8c8286; font-size: 19rpx; letter-spacing: 1rpx; }
.conversation-product { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; padding: 14rpx; border-radius: 16rpx; background: #f9f6f3; }
.conversation-cover { width: 92rpx; height: 92rpx; flex: none; border-radius: 12rpx; background: #f0eae6; }
.conversation-product-main { flex: 1; min-width: 0; }
.conversation-title { display: -webkit-box; color: #1f1a1c; font-size: 27rpx; font-weight: 600; line-height: 1.34; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.conversation-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx 10rpx; margin-top: 6rpx; }
.conversation-price { color: #1f1a1c; font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; }
.conversation-status { padding: 2rpx 10rpx; border-radius: 6rpx; color: #7a6f73; background: #efe9e6; font-size: 20rpx; font-weight: 500; letter-spacing: 1rpx; line-height: 1.6; white-space: nowrap; }
.conversation-status.state-live { color: #8c2346; background: #f8e9ee; }
.conversation-status.state-closed { color: #47705c; background: #eaf1ec; }
.conversation-status.state-warning { color: #8a5a1e; background: #f6eedf; }
.conversation .message-row-bottom { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid #f2edea; }
.row-unread { flex-shrink: 0; width: 12rpx; height: 12rpx; border-radius: 50%; background: #a3264f; }
.row-unread.is-count { min-width: 32rpx; width: auto; height: 32rpx; padding: 0 7rpx; color: #fff; font-size: 18rpx; line-height: 32rpx; text-align: center; }
.row-unread-dot { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; background: #a3264f; }
.messages-list { padding: 4rpx 26rpx; border-radius: 24rpx; }
.message-row { display: flex; align-items: center; gap: 20rpx; min-height: 136rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f2edea; }
.message-row:last-child { border-bottom: 0; }
.message-avatar { width: 84rpx; height: 84rpx; border-radius: 50%; flex-shrink: 0; background: #f3ede9; }
.message-mark { display: grid; place-items: center; color: #8c2346; font-size: 30rpx; }
.message-row-main { flex: 1; min-width: 0; }
.message-row-top, .message-row-bottom { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.message-row-bottom { margin-top: 6rpx; }
.message-title, .message-preview { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.message-title { font-size: 29rpx; line-height: 1.3; font-weight: 600; letter-spacing: .5rpx; }
.message-preview { color: #8c8286; font-size: 25rpx; }
.message-date { white-space: nowrap; flex-shrink: 0; color: #a69ca0; font-size: 21rpx; letter-spacing: .5rpx; font-variant-numeric: tabular-nums; }
.messages-empty { padding: 64rpx 24rpx; text-align: center; font-size: 25rpx; line-height: 1.6; border-radius: 24rpx; }
.empty-icon { display: grid; place-items: center; width: 100rpx; height: 100rpx; margin: 0 auto 20rpx; border-radius: 50%; background: #f6f2ef; }
.empty-title { margin-bottom: 8rpx; color: #1f1a1c; font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif; font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx; }
.messages-empty .primary.auth-action { width: 240rpx; min-height: 80rpx; margin: 28rpx auto 0; font-size: 26rpx; background: #a3264f; }
