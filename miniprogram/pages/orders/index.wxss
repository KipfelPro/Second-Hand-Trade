.orders-page { padding: 22rpx 28rpx 70rpx; }
.order-tabs { display: flex; gap: 8rpx; margin-bottom: 22rpx; padding: 6rpx; border-radius: 16rpx; background: #ece7e3; }
.order-tab { flex: 1; display: grid; place-items: center; min-height: 81rpx; border-radius: 12rpx; color: #8c8286; font-size: 31rpx; }
.order-tab.active { background: #fff; color: var(--pink); font-weight: 700; }
.order-stack { display: grid; gap: 19rpx; }
.order-card { margin: 0; padding: 23rpx; }
.order-card-top, .order-card-main { display: flex; align-items: center; gap: 16rpx; }
.order-card-top { justify-content: space-between; }
.card-date { color: #8c8286; font-size: 27rpx; }
.order-state { padding: 5rpx 14rpx; border-radius: 34rpx; background: #f7ebee; color: #93264e; font-size: 27rpx; font-weight: 650; }
.order-state.completed { background: #edf3ef; color: #47705c; }
.order-state.aftersale { background: #faf0d9; color: #895b16; }
.order-card-main { padding-top: 19rpx; }
.order-image { flex: 0 0 100rpx; width: 100rpx; height: 100rpx; border-radius: 14rpx; background: #f3ece9; }
.order-product { flex: 1; min-width: 0; }
.product-name { font-size: 34rpx; font-weight: 750; line-height: 1.3; }
.product-pickup { margin-top: 5rpx; color: #8c8286; font-size: 28rpx; line-height: 1.4; }
.order-price { flex: none; color: var(--pink); font-size: 35rpx; font-weight: 750; }
.orders-empty { padding: 54rpx 24rpx; text-align: center; }
.empty-icon { display: grid; place-items: center; width: 86rpx; height: 86rpx; margin: 0 auto 16rpx; border-radius: 24rpx; background: #f3ece9; }
.empty-title { font-size: 36rpx; font-weight: 750; }
.empty-button { width: 240rpx; min-height: 88rpx; margin-top: 24rpx; font-size: 34rpx; }
