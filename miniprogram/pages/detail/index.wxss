page { background: #f7f4f0; }
.detail-page { padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }
.gallery { position: relative; overflow: hidden; background: #ece6e2; }
.gallery-swiper { height: 680rpx; }
.gallery-image { display: block; width: 100%; height: 100%; }
.gallery::after { position: absolute; left: 0; right: 0; bottom: 0; height: 120rpx; content: ''; pointer-events: none; background: linear-gradient(180deg, rgba(247, 244, 240, 0), rgba(247, 244, 240, .55)); }
.gallery-count { position: absolute; z-index: 1; right: 32rpx; bottom: 64rpx; padding: 6rpx 18rpx; color: #fff; border-radius: 999rpx; background: rgba(31, 26, 28, .52); font-size: 21rpx; letter-spacing: 2rpx; font-variant-numeric: tabular-nums; pointer-events: none; }
.detail-content { position: relative; z-index: 1; display: grid; gap: 20rpx; margin-top: -40rpx; padding: 0 28rpx 28rpx; }
.detail-content .card { margin: 0; }
.item-summary { padding: 34rpx 32rpx 30rpx; border-radius: 28rpx; box-shadow: 0 4rpx 12rpx rgba(31, 22, 26, .04), 0 20rpx 50rpx rgba(31, 22, 26, .08); }
.seller-card, .detail-section { padding: 30rpx 32rpx; }
.summary-top, .seller-card, .pickup-line, .detail-actions, .item-tags { display: flex; align-items: center; }
.summary-top { justify-content: space-between; gap: 24rpx; margin-top: 18rpx; }
.pickup-line { justify-content: space-between; gap: 24rpx; }
.item-title { color: #1f1a1c; font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif; font-size: 44rpx; font-weight: 600; line-height: 1.32; letter-spacing: 1rpx; }
.item-price { color: #a3264f; font-size: 64rpx; font-weight: 700; line-height: 1; letter-spacing: -1rpx; font-variant-numeric: tabular-nums; }
.price-symbol { margin-right: 4rpx; font-size: 32rpx; font-weight: 600; }
.summary-top .favorite { display: inline-flex; flex: none; align-items: center; gap: 8rpx; width: auto; margin: 0; padding: 0 24rpx; border-radius: 999rpx; background: #fff; box-shadow: inset 0 0 0 1.5rpx #e3dbd6; color: #3d3538; font-size: 25rpx; line-height: 68rpx; letter-spacing: 1rpx; }
.summary-top .favorite.is-favorite { color: #a3264f; background: #f9eef1; box-shadow: inset 0 0 0 1.5rpx #efd4dd; }
.item-tags { gap: 10rpx; flex-wrap: wrap; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #f0ebe8; }
.item-tags .tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.neutral-tag { background: #f4f0ed; color: #6f6469; }
.seller-card { gap: 22rpx; }
.seller-avatar { width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 50%; background: #f1ebe8; box-shadow: 0 0 0 4rpx #fff, 0 0 0 5rpx #ece6e3; }
.avatar-fallback { display: grid; place-items: center; color: #a3264f; font-size: 34rpx; }
.seller-meta { flex: 1; min-width: 0; display: grid; gap: 6rpx; }
.seller-name { font-size: 32rpx; font-weight: 650; line-height: 1.25; letter-spacing: 1rpx; }
.seller-college { color: #8c8286; font-size: 23rpx; letter-spacing: .5rpx; }
.seller-trust { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-top: 4rpx; }
.seller-credit { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 120rpx; padding-left: 24rpx; border-left: 1rpx solid #efe9e6; }
.credit-score { color: #1f1a1c; font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif; font-size: 50rpx; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
.credit-label { margin-top: 4rpx; color: #47705c; font-size: 20rpx; letter-spacing: 1rpx; white-space: nowrap; }
.section-head { display: flex; align-items: baseline; gap: 14rpx; }
.section-index { color: #b6aaa5; font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif; font-size: 24rpx; font-style: italic; letter-spacing: 1rpx; }
.description { display: block; margin-top: 18rpx; color: #3d3538; font-size: 29rpx; line-height: 1.8; letter-spacing: .5rpx; white-space: pre-wrap; word-break: break-word; }
.pickup-line { margin-top: 18rpx; align-items: flex-start; font-size: 28rpx; color: #3d3538; }
.pickup-line text:last-child { text-align: right; }
.pickup-label { white-space: nowrap; color: #8c8286; font-size: 24rpx; letter-spacing: 1rpx; }
.pickup-chat { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; margin-top: 24rpx; padding: 0 24rpx; border-radius: 18rpx; background: #f6f3f0; color: #1f1a1c; font-size: 28rpx; font-weight: 600; letter-spacing: 1rpx; text-align: left; }
.pickup-chat text { flex: 1; }
.detail-actions {
  position: fixed; left: 24rpx; right: 24rpx; bottom: calc(18rpx + env(safe-area-inset-bottom)); z-index: 4;
  display: flex; align-items: center; gap: 14rpx; justify-content: center; padding: 14rpx;
  border-radius: 999rpx; background: rgba(255, 255, 255, .9);
  backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 6rpx 16rpx rgba(31, 22, 26, .06), 0 22rpx 56rpx rgba(31, 22, 26, .14);
}
.detail-actions button { flex: 1; min-height: 88rpx; margin: 0; font-size: 29rpx; }
.detail-actions .secondary { box-shadow: none; background: #f4f0ed; }
.detail-actions .purchase { flex: 1.4; background: #a3264f; box-shadow: 0 10rpx 24rpx rgba(163, 38, 79, .26); }
.detail-actions .purchase[disabled] { background: #a3264f; box-shadow: none; }
.detail-actions .muted { padding: 0 24rpx; line-height: 88rpx; }
.detail-entry { animation: detail-in .22s cubic-bezier(.22,.7,.28,1) both; }
.seller-card.detail-entry { animation-delay: .04s; }
.motion-off .detail-entry { animation: none; }
@keyframes detail-in {
  from { transform: translateY(12rpx); opacity: .5; }
  to { transform: translateY(0); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) { .detail-entry { animation: none; } }
