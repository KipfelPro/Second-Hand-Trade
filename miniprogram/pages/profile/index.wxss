page { background: #f7f4f0; }
.profile { padding: 24rpx 28rpx 56rpx; }
.profile-hero {
  position: relative; overflow: hidden; padding: 34rpx 32rpx 0;
  border-radius: 30rpx; color: #fff;
  background: #1f1a1c;
  box-shadow: 0 8rpx 20rpx rgba(31, 22, 26, .10), 0 28rpx 64rpx rgba(31, 22, 26, .16);
}
.hero-glow { position: absolute; top: -160rpx; right: -120rpx; width: 460rpx; height: 460rpx; border-radius: 50%; background: radial-gradient(circle, rgba(163, 38, 79, .55) 0%, rgba(163, 38, 79, 0) 68%); }
.hero-eyebrow { position: relative; color: rgba(255, 255, 255, .45); font-size: 18rpx; font-weight: 600; letter-spacing: 4rpx; }
.profile-row { position: relative; display: flex; align-items: center; gap: 24rpx; margin-top: 28rpx; }
.avatar { flex: 0 0 116rpx; width: 116rpx; height: 116rpx; border-radius: 50%; border: 3rpx solid rgba(255, 255, 255, .28); background: rgba(255, 255, 255, .1); }
.guest { display: flex; justify-content: center; align-items: center; background: rgba(255, 255, 255, .12); }
.pet { position: absolute; right: -10rpx; top: 26rpx; width: 150rpx; height: 150rpx; opacity: .98; }
.profile-info { flex: 1; min-width: 0; padding-right: 120rpx; }
.nickname { color: #fff; font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif; font-size: 50rpx; font-weight: 600; line-height: 1.2; letter-spacing: 2rpx; }
.college { margin: 8rpx 0 12rpx; color: rgba(255, 255, 255, .58); font-size: 23rpx; letter-spacing: 1rpx; }
.profile-info .verify-cta { display: inline-flex; align-items: center; gap: 6rpx; width: auto; padding: 6rpx 16rpx; color: #1f1a1c; background: #fff; border-radius: 999rpx; font-size: 23rpx; font-weight: 600; }
.credit-row { position: relative; display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; margin: 34rpx -32rpx 0; padding: 26rpx 32rpx; border-top: 1rpx solid rgba(255, 255, 255, .12); }
.credit-main { display: grid; gap: 4rpx; }
.credit-caption { color: rgba(255, 255, 255, .45); font-size: 20rpx; letter-spacing: 3rpx; }
.credit-value { display: flex; align-items: baseline; gap: 12rpx; }
.credit { color: #fff; font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif; font-size: 54rpx; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
.credit-level { color: #c9a86d; font-size: 22rpx; letter-spacing: 2rpx; }
.credit-stats { display: flex; gap: 30rpx; padding-bottom: 6rpx; }
.stat { display: grid; justify-items: center; gap: 2rpx; }
.stat-num { color: #fff; font-size: 32rpx; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
.stat-name { color: rgba(255, 255, 255, .42); font-size: 19rpx; letter-spacing: 2rpx; }
.menu { margin: 24rpx 0; padding: 8rpx 26rpx; border-radius: 28rpx; }
.menu .menu-row { display: flex; align-items: center; text-align: left; width: 100%; border-radius: 0; gap: 20rpx; min-height: 112rpx; padding: 0; border-bottom: 1rpx solid #f0ebe8; }
.menu .menu-row:last-child { border-bottom: 0; }
.menu-icon { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f6f2ef; }
.menu-name { flex: 1; color: #1f1a1c; font-size: 29rpx; font-weight: 500; letter-spacing: 1rpx; }
.menu-count { color: #a69ca0; font-size: 25rpx; font-variant-numeric: tabular-nums; }
.profile .publish-button { width: 100%; margin-top: 8rpx; background: #a3264f; box-shadow: 0 10rpx 26rpx rgba(163, 38, 79, .24); }
