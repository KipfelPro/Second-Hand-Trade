@import '../auth/campus.wxss';

.launch { min-height: 100vh; }
.launch .campus-scrim { background: linear-gradient(180deg,rgba(21,12,25,.57),rgba(34,20,33,.12) 29%,rgba(36,16,35,.69) 67%,#311628 100%); }
.launch-content { width: 100%; margin-top: auto; padding: 38rpx 38rpx 30rpx; }
.launch-mascot { display: flex; justify-content: center; align-items: center; width: 148rpx; height: 148rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(255,255,255,.6); border-radius: 37rpx; background: rgba(249,215,235,.23); }
.mascot { width: 136rpx; height: 136rpx; animation: launch-rise 260ms ease-out both; }
.launch .campus-title { font-size: 82rpx; }
.launch .campus-subtitle { font-size: 34rpx; }
.launch-footer { padding: 16rpx 38rpx calc(46rpx + env(safe-area-inset-bottom)); }
.progress { overflow: hidden; height: 5rpx; margin: 0 0 16rpx; border-radius: 10rpx; background: rgba(248,198,222,.34); }
.progress-fill { height: 100%; background: #ffdcec; transform-origin: left; animation: fill 2s linear both; }
.launch-enter { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 88rpx; padding: 0 22rpx; background: rgba(255,240,249,.16); border: 1rpx solid rgba(255,233,246,.42); border-radius: 18rpx; color: #fff7fc; font-size: 34rpx; font-weight: 650; }
.motion-off .mascot, .motion-off .progress-fill { animation: none; }
@keyframes launch-rise { from { opacity: 0; transform: translateY(12rpx) scale(.9); } to { opacity: 1; transform: none; } }
@keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
@media (prefers-reduced-motion: reduce) { .mascot, .progress-fill { animation: none; } }
