.order-page { padding: 22rpx 28rpx 48rpx; }
.order-page.has-order-actions { padding-bottom: calc(145rpx + env(safe-area-inset-bottom)); }
.state-hero { position: relative; margin-bottom: 20rpx; overflow: hidden; padding: 26rpx 114rpx 26rpx 27rpx; border-radius: 16rpx; background: #a3264f; color: #fff; }
.state-hero.completed { background: #356855; }
.state-hero.aftersale { background: #8a5a38; }
.state-mark { position: absolute; top: 24rpx; right: 26rpx; display: grid; place-items: center; width: 68rpx; height: 68rpx; border: 1rpx solid rgba(255,255,255,.36); border-radius: 50%; background: rgba(255,255,255,.15); }
.state-mark.payment-mark { animation: order-mark-in .17s cubic-bezier(.24,.76,.35,1) both; }
.state-mark.completion-mark { animation: order-complete-in .20s cubic-bezier(.24,.76,.35,1) both; }
.state-title { min-height: 61rpx; font-size: 46rpx; line-height: 1.25; font-weight: 750; }
.state-text { margin-top: 8rpx; color: rgba(255, 255, 255, .97); font-size: 34rpx; line-height: 1.44; }
.payment-confirmed { display: inline-block; margin-top: 8rpx; padding: 4rpx 11rpx; border-radius: 8rpx; background: rgba(255,255,255,.16); font-size: 25rpx; }
.timeline-card, .order-info { padding: 24rpx; margin: 0 0 18rpx; }
.timeline { display: flex; margin-top: 18rpx; padding: 19rpx 2rpx 16rpx; border-radius: 14rpx; background: #f9f6f3; }
.timeline-step { position: relative; flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx; min-width: 0; color: #8c8286; }
.timeline-track { position: absolute; top: 27rpx; right: calc(50% + 33rpx); width: calc(100% - 66rpx); height: 6rpx; border-radius: 6rpx; background: #e8dbe1; }
.timeline-step.reached .timeline-track, .timeline-step.current .timeline-track { background: #d48aa9; }
.timeline-node { position: relative; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border: 2rpx solid #decfd6; border-radius: 50%; background: #fff; }
.timeline-step.reached .timeline-node { border-color: #eac5d6; background: #f7e3ec; }
.timeline-step.current .timeline-node { border-color: #a3264f; background: #a3264f; box-shadow: 0 0 0 4rpx #f2d8e5; }
.timeline-step.reached { color: #5c3246; font-weight: 650; }
.timeline-step.current { color: #8e214f; font-weight: 750; }
.timeline-label { max-width: 100%; font-size: 28rpx; line-height: 1.25; text-align: center; white-space: nowrap; }
.timeline-complete { background: #f3f8f5; }
.timeline-complete .timeline-track { background: #98c3ae; }
.timeline-complete .timeline-node { border-color: #b7d6c6; background: #e7f3ec; }
.timeline-complete .timeline-step { color: #31594a; }
.timeline-complete .final-node .timeline-node { border-color: #356855; background: #356855; box-shadow: 0 0 0 4rpx #d7e9e0; }
.order-item { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; padding: 12rpx 0 18rpx; border-bottom: 1rpx solid var(--line); }
.order-image { flex-shrink: 0; width: 94rpx; height: 94rpx; border-radius: 12rpx; background: #f3ece9; }
.order-product { flex: 1; min-width: 0; font-size: 28rpx; }
.order-product .muted { color: #8c8286; }
.item-title { margin-bottom: 6rpx; font-size: 34rpx; font-weight: 750; line-height: 1.3; }
.order-row { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-top: 14rpx; font-size: 32rpx; }
.order-row text:first-child { flex-shrink: 0; color: #8c8286; font-size: 28rpx; }
.order-row text:last-child { text-align: right; word-break: break-word; }
.row-amount { color: var(--pink); font-size: 35rpx; font-weight: 750; }
.contact-seller { display: flex; align-items: center; gap: 12rpx; min-height: 82rpx; margin-top: 20rpx; padding: 0 17rpx; border-radius: 12rpx; background: #f5e8ee; color: #972d57; font-size: 32rpx; font-weight: 650; text-align: left; }
.contact-seller text { flex: 1; }
.pickup-order-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.pickup-order-heading .tag { font-size: 25rpx; }
.pickup-booked { color: #47705c; background: #edf3ef; }
.contact-seller.handoff-action { margin-top: 10rpx; }
.detail-copy { display: block; margin-top: 14rpx; color: #594952; font-size: 34rpx; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }
.order-actions { position: fixed; z-index: 4; bottom: 0; left: 0; right: 0; display: flex; gap: 18rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: #fff; }
.order-actions button { flex: 1; min-height: 88rpx; margin: 0; font-size: 34rpx; }
.sheet-overlay { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; background: rgba(32, 18, 26, .42); }
.sheet { position: relative; box-sizing: border-box; width: 100%; padding: 22rpx 28rpx calc(26rpx + env(safe-area-inset-bottom)); border-radius: 25rpx 25rpx 0 0; background: #fff; }
.sheet-heading { display: flex; align-items: center; min-height: 88rpx; margin-bottom: 16rpx; padding-right: calc(44px + 20rpx); }
.close-sheet { position: absolute; top: 16rpx; right: 24rpx; z-index: 1; display: flex; align-items: center; justify-content: center; width: 86rpx; min-width: 44px; height: 86rpx; min-height: 44px; margin: 0; padding: 0; border-radius: 18rpx; background: #f8f1f5; }
.sheet-input { box-sizing: border-box; width: 100%; height: 150rpx; margin-bottom: 18rpx; padding: 18rpx; border-radius: 12rpx; background: #f6f1f4; font-size: 34rpx; }
.sheet .primary { min-height: 88rpx; font-size: 34rpx; }
.rating-stars { display: flex; justify-content: center; margin-bottom: 18rpx; }
.rating-star { display: grid; place-items: center; width: 77rpx; height: 72rpx; margin: 0; padding: 0; background: transparent; color: #d4c4ce; font-size: 47rpx; }
.rating-result { margin-top: 10rpx; color: #d4c4ce; font-size: 36rpx; letter-spacing: 5rpx; }
.rating-star.filled, .rating-result .filled { color: #a3264f; }
.timeline-step.current .timeline-node, .timeline-step.final-node .timeline-node { animation: order-mark-in .16s cubic-bezier(.24,.76,.35,1) both; }
.sheet { animation: order-sheet-in .16s cubic-bezier(.24,.76,.35,1) both; }
.motion-off .state-mark.payment-mark, .motion-off .state-mark.completion-mark, .motion-off .timeline-step.current .timeline-node, .motion-off .timeline-step.final-node .timeline-node, .motion-off .sheet { animation: none; }
@keyframes order-mark-in {
  from { opacity: .4; transform: scale(.84); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes order-complete-in {
  0% { transform: scale(.88); }
  60% { transform: scale(1.05); }
  100% { transform: scale(1); }
}
@keyframes order-sheet-in {
  from { transform: translateY(18rpx); }
  to { transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) { .state-mark.payment-mark, .state-mark.completion-mark, .timeline-step.current .timeline-node, .timeline-step.final-node .timeline-node, .sheet { animation: none; } }
