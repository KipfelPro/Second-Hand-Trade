page { background: #f7f4f0; }

.favorites-page { padding: 26rpx 28rpx 48rpx; }

.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.favorite {
  overflow: hidden;
  border: 1rpx solid #e3dbd6;
  border-radius: 16rpx;
  background: #fff;
}

.favorite-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 57rpx;
  padding: 0 17rpx;
  font-size: 27rpx;
}

.remove {
  margin-left: auto;
  padding: 10rpx 5rpx;
  color: #8c2346;
  font-size: 29rpx;
}

.favorites-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 130rpx 24rpx 55rpx;
  text-align: center;
  font-size: 33rpx;
}

.favorite-icon {
  display: grid;
  place-items: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 33rpx;
  background: #f3ece9;
}

.favorite-heading {
  color: #1f1a1c;
  font-size: 38rpx;
  font-weight: 700;
}

.view-list {
  margin-top: 10rpx;
  padding: 18rpx 30rpx;
  border-radius: 14rpx;
  background: #ad2b61;
  color: #fff;
  font-weight: 650;
}

.fav-pressed { opacity: .73; }
