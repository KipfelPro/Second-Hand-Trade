<view class="browse-page">
  <view class="browse-search">
    <t-icon name="search" size="30" color="#9A9095" />
    <input class="browse-input" value="{{query}}" maxlength="80" placeholder="搜索教材、宿舍好物等" placeholder-class="browse-placeholder" confirm-type="search" bindinput="inputQuery" bindconfirm="submitQuery" />
    <button wx:if="{{query}}" class="clear-search" bindtap="clearQuery" hover-class="browse-pressed" aria-label="清除搜索"><t-icon name="close" size="25" color="#8a7f84" /></button>
    <button class="browse-button" bindtap="submitQuery" hover-class="browse-pressed">搜索</button>
  </view>

  <view class="scope-picker" aria-role="group" aria-label="选择浏览范围">
    <view wx:for="{{scopes}}" wx:key="id" class="scope-option {{scope === item.id ? 'scope-active' : ''}}" data-id="{{item.id}}" bindtap="chooseScope" hover-class="browse-pressed" aria-role="button" aria-pressed="{{scope === item.id}}"><text>{{item.label}}</text></view>
  </view>

  <view wx:if="{{scope === 'college' && !verified}}" class="browse-empty">
    <view class="empty-mark"><t-icon name="shield" size="40" color="ink" /></view>
    <view class="empty-title">认证后查看同学院闲置</view>
    <button class="control control-active" bindtap="authenticate" hover-class="browse-pressed">去认证</button>
  </view>
  <block wx:else>
    <view class="browse-toolbar">
      <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="chooseCategory">
        <view class="control" hover-class="browse-pressed" aria-label="选择商品分类"><t-icon name="grid" size="24" color="ink" /><text>{{categories[categoryIndex].name}}</text><text class="caret">⌄</text></view>
      </picker>
      <picker mode="selector" range="{{sorts}}" range-key="label" value="{{sortIndex}}" bindchange="changeSort">
        <view class="control" hover-class="browse-pressed" aria-label="排序"><text>{{sorts[sortIndex].label}}</text><text class="caret">⌄</text></view>
      </picker>
    </view>
    <view class="browse-summary"><text class="summary-count">{{resultCount}}</text> 件闲置<text wx:if="{{submittedQuery}}" class="summary-query"> · “{{submittedQuery}}”</text></view>
    <view wx:if="{{products.length}}" class="browse-feed">
      <product-card wx:for="{{products}}" wx:key="id" product="{{item}}" layout="list" hide-college="{{true}}" />
      <button wx:if="{{hasMore}}" class="load-more" bindtap="onReachBottom" hover-class="browse-pressed">加载更多</button>
    </view>
    <view wx:else class="browse-empty">
      <view class="empty-title">暂时没找到合适的闲置</view>
      <view class="empty-actions">
        <button wx:if="{{submittedQuery || categoryIndex}}" class="control" bindtap="showAll" hover-class="browse-pressed">清除筛选</button>
        <button class="control control-active" bindtap="openWant" hover-class="browse-pressed">发布求购</button>
      </view>
    </view>
  </block>
  <pet-fab />
</view>
