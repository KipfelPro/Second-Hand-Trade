.settings-list { padding: 0 20rpx; margin-bottom: 24rpx; }
.setting { padding: 0 8rpx; width: 100%; min-height: 98rpx; display: flex; align-items: center; gap: 17rpx; text-align: left; border-radius: 0; border-bottom: 1rpx solid var(--line); }
.setting:last-child { border: 0; }
.setting text { flex: 1; font-weight: 630; }
