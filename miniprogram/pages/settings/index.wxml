<view class="page settings">
  <view class="card settings-list">
    <button class="setting" bindtap="explain" hover-class="tap"><t-icon name="info" size="{{36}}"/><text>关于本地演示</text><t-icon name="chevron-right" color="muted" size="{{26}}"/></button>
    <view class="setting"><t-icon name="spark" size="{{36}}"/><text>减少动态效果</text><switch checked="{{reducedMotion}}" color="#a3264f" bindchange="changeMotion" aria-label="减少动态效果"/></view>
    <button class="setting" bindtap="reset" hover-class="tap"><t-icon name="settings" size="{{36}}"/><text>重置演示数据</text><t-icon name="chevron-right" color="muted" size="{{26}}"/></button>
  </view>
  <button wx:if="{{user}}" class="secondary" bindtap="logout" hover-class="tap"><t-icon name="logout" size="{{35}}"/>退出校园身份</button>
</view>
<pet-fab motion-paused="{{reducedMotion}}"/>
