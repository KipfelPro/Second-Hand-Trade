.listings-page { padding: 22rpx 28rpx calc(145rpx + env(safe-area-inset-bottom)); }
.listing-tabs { display: flex; gap: 8rpx; margin-bottom: 22rpx; padding: 6rpx; border-radius: 16rpx; background: #ece7e3; }
.listing-tab { flex: 1 1 0; min-width: 0; display: grid; place-items: center; min-height: 74rpx; border-radius: 12rpx; color: #6f6469; font-size: 34rpx; white-space: nowrap; }
.listing-tab.active { background: #fff; color: var(--pink); font-weight: 700; }
.listing-stack { display: grid; gap: 19rpx; }
.listing-card { margin: 0; padding: 20rpx; }
.listing-row { display: flex; align-items: flex-start; gap: 16rpx; }
.listing-image { flex: 0 0 110rpx; width: 110rpx; height: 110rpx; border-radius: 14rpx; background: #f3ece9; }
.listing-main { min-width: 0; flex: 1; }
.listing-title { font-size: 34rpx; font-weight: 700; line-height: 1.32; overflow-wrap: anywhere; }
.listing-date { margin: 6rpx 0; color: #8c8286; font-size: 26rpx; }
.listing-price { color: #a62c5b; font-size: 34rpx; font-weight: 700; }
.listing-status { flex-shrink: 0; padding: 5rpx 12rpx; border-radius: 34rpx; background: #f4ebef; color: #6c5864; font-size: 26rpx; white-space: nowrap; }
.listing-status.active { background: #edf3ef; color: #47705c; }
.listing-status.sold { background: #f7ebee; color: #9e2d57; }
.listing-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 17rpx; border-top: 1rpx solid var(--line); padding-top: 15rpx; }
.mini-button { margin: 0; padding: 0 20rpx; border-radius: 12rpx; background: #ece7e3; color: var(--ink); font-size: 28rpx; line-height: 66rpx; }
.mini-button.action-button { background: #f7ebee; color: var(--pink); }
.listings-empty { padding: 54rpx 24rpx; text-align: center; }
.empty-icon { display: grid; place-items: center; width: 86rpx; height: 86rpx; margin: 0 auto 16rpx; border-radius: 24rpx; background: #f3ece9; }
.empty-title { font-size: 35rpx; font-weight: 700; }
.empty-button { width: 240rpx; margin-top: 24rpx; }
.listings-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 4; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: #fff; }
.listings-bar button { width: 100%; margin: 0; font-size: 34rpx; }
